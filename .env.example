NODE_ENV=development

# Infrastructure Ports
POSTGRES_DB=sushi_platform
POSTGRES_USER=sushi_app
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=sushi_app
RABBITMQ_DEFAULT_PASS=change_me_local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Service Database Connection URLs (PostgreSQL - Schema per service)
IDENTITY_DATABASE_URL=postgresql://identity_app:change_me_local@localhost:5432/sushi_platform?schema=identity
CATALOG_DATABASE_URL=postgresql://catalog_app:change_me_local@localhost:5432/sushi_platform?schema=catalog
ORDERING_DATABASE_URL=postgresql://ordering_app:change_me_local@localhost:5432/sushi_platform?schema=ordering
INVENTORY_DATABASE_URL=postgresql://inventory_app:change_me_local@localhost:5432/sushi_platform?schema=inventory
PURCHASING_DATABASE_URL=postgresql://purchasing_app:change_me_local@localhost:5432/sushi_platform?schema=purchasing
FINANCE_DATABASE_URL=postgresql://finance_app:change_me_local@localhost:5432/sushi_platform?schema=finance

# Message Broker & Cache URLs
RABBITMQ_URL=amqp://sushi_app:change_me_local@localhost:5672
REDIS_URL=redis://localhost:6379

# Service HTTP Ports
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
ORDERING_SERVICE_PORT=3003
INVENTORY_SERVICE_PORT=3004
PURCHASING_SERVICE_PORT=3005
FINANCE_SERVICE_PORT=3006

# Security / JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
